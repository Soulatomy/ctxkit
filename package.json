{
  "name": "fingerprint-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.cjs",
  "description": "Multi-profile anti-detect browser: pluggable engines (chrome-lite / camoufox) behind one InjectionHost interface, a local console/API, and an Electron desktop shell.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/cli.ts serve",
    "profiles:create": "tsx src/cli.ts profiles:create",
    "profiles:list": "tsx src/cli.ts profiles:list",
    "launch": "tsx src/cli.ts launch",
    "check": "tsx scripts/check.ts",
    "test": "tsx test/logic.test.ts && tsx test/api.test.ts",
    "test:integration": "tsx test/integration/persistence.test.ts && tsx test/integration/api-launch.test.ts",
    "typecheck": "tsc --noEmit",
    "make:icon": "node scripts/make-icon.mjs",
    "ensure:browser-dist": "node -e \"require('fs').mkdirSync('browser-dist',{recursive:true})\"",
    "provision:camoufox": "node scripts/provision-camoufox.mjs",
    "electron:build": "esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --packages=external --outdir=electron/dist --out-extension:.js=.cjs",
    "electron:dev": "npm run electron:build && electron . --no-sandbox",
    "dist": "npm run make:icon && npm run ensure:browser-dist && npm run electron:build && electron-builder",
    "dist:win": "npm run make:icon && npm run ensure:browser-dist && npm run electron:build && electron-builder --win",
    "dist:mac": "npm run make:icon && npm run ensure:browser-dist && npm run electron:build && electron-builder --mac"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "patchright": "^1.63.0"
  },
  "optionalDependencies": {
    "@camoufox/camoufox": "^0.5.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "playwright-core": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
